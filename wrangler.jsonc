{
  "name": "pl-craft",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist/web",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "craft.lmk.one/*",
      "zone_name": "lmk.one"
    },
    {
      "pattern": "pl.lmk.one/*",
      "zone_name": "lmk.one"
    }
  ]
}
